{
  "name": "unvibe",
  "version": "0.1.0",
  "private": true,
  "description": "Unvibe — an escape hatch for vibe-locked apps. Point it at a Lovable app you own and get back a real, self-hostable repo.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "clean": "rm -rf packages/*/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
